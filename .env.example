# 이 파일은 **키만** 담는다. 값을 채우지 않는다. 커밋되는 것은 이 파일뿐이다.
# 사용법: 이 파일을 .env 로 복사한 뒤 사람이 직접 값을 채운다. .env 는 gitignore 대상이다.
# 에이전트는 .env 를 읽지도 쓰지도 않는다 (REQ-037). 값 주입은 사람만 한다.

# 텔레그램 봇 토큰. @BotFather 발급. 형식: 숫자8~10 : 35자
IMWEB_WIDGET_BOT_TOKEN=

# 지시를 허용할 chat_id. 쉼표로 여러 개. 비어 있으면 아무도 통과하지 못한다.
ALLOWED_CHAT_IDS=

# jsDelivr 배포 대상 GitHub 저장소 (public 필요)
CDN_OWNER=
CDN_REPO=

# 아래는 M2 이후. 지금은 비워둔다.
# CHK-001~003 미해소 상태에서는 값이 있어도 호출이 차단된다 (gateBlock).
IMWEB_API_KEY=
IMWEB_API_SECRET=

# 구글 Search Console API (설치형 앱 OAuth).
# Google Cloud Console → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID → **데스크톱 앱**
# 승인된 리디렉션 URI 는 필요 없다(루프백 방식). 아래 두 API 를 먼저 사용 설정할 것:
#   - Google Search Console API
#   - Site Verification API
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
