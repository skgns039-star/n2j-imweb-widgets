{
  "permissions": {
    "allow": [
      "Bash(npm test)", "Bash(npm run typecheck)", "Bash(npm run lint)",
      "Bash(npm run secretscan)", "Bash(npm run build)",
      "Bash(npm run verify:integrity:*)", "Bash(npm run stest:coverage)",
      "Bash(node --test:*)", "Bash(node checks/daily.ts)",
      "Bash(git add:*)", "Bash(git commit:*)", "Bash(git status:*)",
      "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)",

      "Read", "Write", "Edit", "Glob", "Grep",

      "Bash(npm run verify:integrity)", "Bash(npm run setup:check)",
      "Bash(npm run whoami)", "Bash(npm ci)", "Bash(npm install:*)",
      "Bash(npx tsc:*)", "Bash(node checks/:*)", "Bash(node -e:*)",

      "Bash(git ls-files:*)", "Bash(git check-ignore:*)",
      "Bash(git remote:*)", "Bash(git branch:*)", "Bash(git rev-parse:*)"
    ],
    "deny": [
      "Bash(npm run deploy:*)", "Bash(npm run rollback:*)",
      "Bash(git push:*)", "Bash(git tag:*)", "Read(./.env)"
    ]
  }
}
