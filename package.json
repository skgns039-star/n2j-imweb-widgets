{
  "name": "imweb-widget-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/bot/index.ts",
    "build": "node src/release/build.ts",
    "deploy": "node --env-file-if-exists=.env src/release/deploy.ts",
    "rollback": "node --env-file-if-exists=.env src/release/rollback.ts",
    "verify:integrity": "node src/release/verify.ts",
    "lint": "node src/release/css_scope_lint.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "secretscan": "node checks/secret_scan.ts",
    "setup:check": "node --env-file-if-exists=.env checks/setup_check.ts",
    "whoami": "node --env-file-if-exists=.env checks/whoami.ts",
    "stest:coverage": "node checks/stest_coverage.ts",
    "posttest": "node checks/purge_fixtures.ts",
    "imweb:login": "node --env-file-if-exists=.env src/browser/session.ts",
    "console:login": "node --env-file-if-exists=.env src/browser/console_session.ts",
    "seo:register": "node --env-file-if-exists=.env src/browser/register.ts",
    "seo:verify": "node --env-file-if-exists=.env src/browser/naver_verify.ts",
    "google:auth": "node --env-file-if-exists=.env src/google/oauth.ts",
    "google:gsc": "node --env-file-if-exists=.env src/google/gsc.ts",
    "daum:apply": "node --env-file-if-exists=.env src/browser/daum_register.ts",
    "naver:index": "node --env-file-if-exists=.env src/browser/naver_index.ts",
    "bing:setup": "node --env-file-if-exists=.env src/bing/api.ts"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.241",
    "playwright": "^1.62.1",
    "yaml": "^2.6.1"
  }
}
